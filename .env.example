QQBOT_APPID=机器人 AppID
QQBOT_SECRET=机器人 AppSecret
# 默认使用 SQLite，无需配置数据库；使用 MySQL 时取消以下注释并填写连接信息。
# QQBOT_DATABASE_TYPE=mysql
# QQBOT_MYSQL_HOST=127.0.0.1
# QQBOT_MYSQL_PORT=3306
# QQBOT_MYSQL_USER=机器人数据库用户
# QQBOT_MYSQL_PASSWORD=机器人数据库密码
# QQBOT_MYSQL_DATABASE=机器人数据库名
# QQBOT_MYSQL_CONNECTION_LIMIT=10
# QQBOT_PLUGIN_DIR=./plugins
# QQBOT_LOG_LEVEL=info
# QQBOT_CONSOLE=1
# 框架临时图床（所有插件共用）：external 外部图床 / builtin 内置图床，默认 external。
# 非敏感配置也可在管理页面保存；环境变量优先，修改后重启生效。
# QQBOT_IMAGE_HOST_MODE=external
# 外部模式：分别填写根地址和完整上传地址，不会自动拼接上传路径。
# QQBOT_IMAGE_HOST_ORIGIN=https://images.example.com
# QQBOT_IMAGE_UPLOAD_URL=https://images.example.com/api/upload
# QQBOT_IMAGE_UPLOAD_TOKEN=至少16个字符的图床上传令牌
# 内置模式：不需要图床 Token，需要 QQ 可访问的管理页面公网根地址。
# QQBOT_IMAGE_HOST_MODE=builtin
# QQBOT_WEB_PUBLIC_ROOT=https://bot.example.com
# 内置图片保留时间（小时），默认 24；启动和每 10 分钟清理过期图片。
# QQBOT_IMAGE_RETENTION_HOURS=24
# QQBOT_WEB_HOST=127.0.0.1
# QQBOT_WEB_PORT=3000
# 必填，至少 16 个字符；管理页面在本机监听时也会强制登录
QQBOT_WEB_TOKEN=
